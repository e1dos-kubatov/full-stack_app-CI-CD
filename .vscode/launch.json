{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Flask",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_DEBUG": "1",
        "PORT": "5000"
      },
      "args": ["run", "--host", "0.0.0.0", "--port", "5000"],
      "jinja": true
    }
  ]
}
